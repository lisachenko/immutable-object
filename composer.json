{
    "name": "lisachenko/immutable-object",
    "description": "Immutable objects from pure PHP by rewriting engine object handlers through z-engine; a showcase now that PHP has native readonly classes",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexander Lisachenko",
            "email": "lisachenko.it@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-ffi": "*",
        "lisachenko/z-engine": "~8.4.2 || ~8.5.0 || ~8.6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.3.6"
    },
    "autoload": {
        "psr-4": {
            "Immutable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Immutable\\": "tests/"
        }
    }
}
